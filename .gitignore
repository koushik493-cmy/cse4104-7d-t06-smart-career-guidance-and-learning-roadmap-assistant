# Root-level gitignore

# Environment files (NEVER commit secrets)
.env
*.env
.env.local
.env.production
.env.backup

# Node modules
node_modules/
**/node_modules/

# Build outputs
dist/
dist-ssr/
**/dist/
public/build/
public/hot/

# Laravel/PHP vendor
backend/vendor/
backend/public/storage/
backend/storage/*.key
backend/storage/pail/
backend/public/fonts-manifest.dev.json

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Editor directories
.vscode/
.idea/
.nova/
.zed/
.cursor/
.codex/

# PHP cache/temp
*.phpunit.result.cache
.phpunit.cache/
auth.json
_ide_helper.php
Homestead.json
Homestead.yaml

# Misc
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local
