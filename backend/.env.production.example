# ==========================================
# PRODUCTION ENVIRONMENT VARIABLES FOR RENDER
# ==========================================

APP_NAME="aria"
APP_ENV=production
# Generate one using `php artisan key:generate --show` locally:
APP_KEY=base64:qNrVNo0ixvSfwAlOiXhZRl1tTr0REp4wN9N8UAFDkE4=
APP_DEBUG=false
# Fill this with your actual Render service URL (e.g., https://aria-backend.onrender.com):
APP_URL=https://your-backend.onrender.com

# ------------------------------------------
# SUPABASE DATABASE SETTINGS (PostgreSQL)
# ------------------------------------------
# Find these in Supabase Dashboard -> Project Settings -> Database
# Use the "Connection Pooler" (Session Mode) host to avoid IPv6 issues!
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your_project_ref
DB_PASSWORD=your_supabase_db_password
DB_SSLMODE=require

# ------------------------------------------
# APPLICATION DRIVERS
# ------------------------------------------
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stderr
LOG_LEVEL=error

# ------------------------------------------
# AI & EXTERNAL SERVICES
# ------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Disable heavy dev/monitoring tools in production to save memory
PULSE_ENABLED=false
TELESCOPE_ENABLED=false

# Set to 'true' ONLY on the first deployment to seed default data (admin, careers, skills), then set to 'false'
SEED_DATABASE=true
